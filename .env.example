# API Keys (local .env and Render Environment)

# Required for live Chat on local and Render
OPENAI_API_KEY=your_openai_api_key_here

# Optional - collectors only (do NOT need these on Render for Overview/Chat)
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Note: Reddit scraping uses public unauthenticated .json endpoints. No Reddit API key required.

# Deploy standing rule:
# Compute scrape/extract/index locally. Commit data/processed/reviews.db and
# data/processed/chroma_db. Render only serves those files - it never recomputes.
